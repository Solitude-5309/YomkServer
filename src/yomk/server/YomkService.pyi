from typing import Any, Callable, Dict, Optional

from yomk.msgs.fn_pool import FuncInfo
from yomk.msgs.server import Response
from yomk.msgs.YomkMsg import YomkMsg


class YomkService:
    name: str
    server: Any
    _server_ref: Any
    functions: Dict[str, Callable[[Any], Response]]
    function_infos: Dict[str, FuncInfo]
    registered: bool
    m_deleted: bool
    rwlock_functions: Any

    def __init__(self, server: Any) -> None: ...
    def get_name(self) -> str: ...
    def set_name(self, name: str) -> None: ...
    def mark_registered(self) -> None: ...
    def mark_deleted(self) -> None: ...
    def deleted(self) -> bool: ...
    def weak_func(self, func: Callable[..., Any], discard: Optional[str] = None) -> Callable[..., Any]: ...
    def init(self) -> None: ...
    def deinit(self) -> None: ...
    def install_func(self, name: str, function: Callable[[Any], Response],
                     msg_name: str = "", description: str = "") -> None: ...
    def func_infos(self) -> Dict[str, FuncInfo]: ...
    def invoke(self, name: str, pkg: Any) -> Response: ...
    def request(self, url: str, pkg: Optional[YomkMsg] = None) -> Response: ...
    def async_request(self, url: str, pkg: Optional[YomkMsg] = None,
                      callback: Optional[Callable[[Any], None]] = None) -> None: ...
