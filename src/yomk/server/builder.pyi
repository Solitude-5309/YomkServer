from typing import Any, Callable, Optional

from yomk.msg.server import ResStatus, Response
from yomk.server.YomkServer import YomkServer
from yomk.server.YomkService import YomkService


class YomkBoot:
    def __init__(self) -> None: ...
    def before(self) -> int: ...
    def start(self) -> int: ...
    def after(self) -> int: ...


class AsyncRequestBuilder:
    def __init__(self, url: str,
                 callback: Optional[Callable[[Any], None]] = None) -> None: ...
    def msg(self, m: Any) -> "AsyncRequestBuilder": ...
    def request(self) -> None: ...


class ServerBuilder:
    def __init__(self) -> None: ...
    def url(self, u: str) -> "ServerBuilder": ...
    def msg(self, m: Any) -> "ServerBuilder": ...
    def request(self) -> Response: ...
    def status(self) -> ResStatus: ...
    def async_(self, func: Optional[Callable[[Any], None]] = None) -> AsyncRequestBuilder: ...
    def version(self) -> str: ...
    def async_thread(self, n: int) -> "ServerBuilder": ...
    def init(self) -> None: ...
    def instance(self) -> Optional[YomkServer]: ...
    def shutdown(self) -> None: ...
    def srv(self, cls: type, name: str = "") -> "ServerBuilder": ...
    def create(self) -> int: ...
    def srv_name(self, n: str) -> "ServerBuilder": ...
    def srv_ptr(self, s: YomkService) -> "ServerBuilder": ...
    def add(self) -> int: ...
    def remove(self) -> int: ...
    def boot_ptr(self, b: YomkBoot) -> "ServerBuilder": ...
    def run(self) -> int: ...


def server() -> ServerBuilder: ...