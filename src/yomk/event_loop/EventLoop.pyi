from typing import Any, Callable, Optional

from yomk.msgs.event_loop import Event as Event
from yomk.msgs.event_loop import EventLoopInfo


class EventLoop:
    m_event_queue: Any
    m_queueMutex: Any
    m_condition: Any
    m_thread: Any
    m_running: bool
    m_event_id: int
    m_defaultServiceFunc: Optional[Callable[[Any], Any]]
    m_defaultMsgName: str

    def __init__(self) -> None: ...
    def set_default_service_func(self, func: Optional[Callable[[Any], Any]],
                                 msg_name: str = "") -> None: ...
    def run(self) -> None: ...
    def start(self) -> int: ...
    def stop(self) -> int: ...
    def destroy(self) -> int: ...
    def __del__(self) -> None: ...
    def post(self, event: Event) -> int: ...
    def post_wait(self, event: Event) -> int: ...
    def info_snapshot(self, info: EventLoopInfo, tag_count: int) -> None: ...
