from typing import Any, Callable, Optional

from yomk.msg.server import ResStatus, Response


class EventLoopBuilder:
    def __init__(self) -> None: ...
    def loop(self, n: str) -> "EventLoopBuilder": ...
    def handle_fn(self, f: Optional[Callable[[Any], Any]]) -> "EventLoopBuilder": ...
    def msg_name(self, m: str) -> "EventLoopBuilder": ...
    def msg(self, data: Any) -> "EventLoopBuilder": ...
    def tag(self, t: str) -> "EventLoopBuilder": ...
    def tag_count(self, n: int) -> "EventLoopBuilder": ...
    def start(self) -> ResStatus: ...
    def stop(self) -> ResStatus: ...
    def post(self) -> ResStatus: ...
    def post_wait(self) -> ResStatus: ...
    def destroy(self) -> ResStatus: ...
    def list(self) -> Response: ...
    def get_info(self) -> Response: ...
    def all(self) -> Response: ...


def event_loop() -> EventLoopBuilder: ...