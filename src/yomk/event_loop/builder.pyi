from typing import Any, Callable, Optional

from yomk.msgs.server import ResStatus, Response
from yomk.msgs.YomkMsg import YomkMsg


class EventLoopBuilder:
    def __init__(self) -> None: ...
    def loop(self, name: str) -> "EventLoopBuilder": ...
    def handle_fn(self, fn: Optional[Callable[[Any], Any]]) -> "EventLoopBuilder": ...
    def msg_name(self, msg_name: str) -> "EventLoopBuilder": ...
    def msg(self, data: Optional[YomkMsg]) -> "EventLoopBuilder": ...
    def tag(self, t: str) -> "EventLoopBuilder": ...
    def tag_count(self, n: int) -> "EventLoopBuilder": ...
    def start(self) -> ResStatus: ...
    def stop(self) -> ResStatus: ...
    def post(self) -> ResStatus: ...
    def post_wait(self) -> ResStatus: ...
    def destroy(self) -> ResStatus: ...
    def list(self) -> Response: ...
    def get_info(self) -> Response: ...
    def all(self) -> Response: ...


def event_loop() -> EventLoopBuilder: ...
