from typing import Any, Dict

from yomk.event_loop.EventLoop import EventLoop
from yomk.msgs.event_loop import Event, EventLoopOpts, EventLoopQuery
from yomk.msgs.server import Response
from yomk.server import YomkService


class YomkEventLoop(YomkService):
    m_eventLoop: Dict[str, EventLoop]
    m_eventLoopMutex: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    def start(self, msg: EventLoopOpts) -> Response: ...
    def stop(self, msg: str) -> Response: ...
    def destroy(self, msg: str) -> Response: ...
    def post(self, msg: Event) -> Response: ...
    def post_wait(self, msg: Event) -> Response: ...
    def loops(self, msg: Any) -> Response: ...
    def loop_info(self, msg: EventLoopQuery) -> Response: ...
    def list_all(self, msg: Any) -> Response: ...
    def deinit(self) -> None: ...
