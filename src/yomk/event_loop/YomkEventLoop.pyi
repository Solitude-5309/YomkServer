from typing import Any, Dict

from yomk.event_loop.EventLoop import Event, EventLoop
from yomk.msg.event_loop import EventLoopPkg, EventLoopQuery
from yomk.msg.server import Response
from yomk.server import YomkService


class YomkEventLoop(YomkService):
    m_eventLoop: Dict[str, EventLoop]
    m_eventLoopMutex: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    def start(self, pkg: EventLoopPkg) -> Response: ...
    def stop(self, pkg: str) -> Response: ...
    def destroy(self, pkg: str) -> Response: ...
    def post(self, pkg: Event) -> Response: ...
    def post_wait(self, pkg: Event) -> Response: ...
    def loops(self, pkg: Any) -> Response: ...
    def loop_info(self, pkg: EventLoopQuery) -> Response: ...
    def list_all(self, pkg: Any) -> Response: ...
    def deinit(self) -> None: ...