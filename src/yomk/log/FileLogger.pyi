from typing import Any


class FileLogger:
    # 文件日志器（sink），log 入内存缓冲、write 追加落盘清缓冲、
    # 析构自动 write 兜底；init 建目录与空文件、六级门控（关断级别不入缓冲）
    m_name: str
    m_dir: str
    m_showTraceLog: bool
    m_showDebugLog: bool
    m_showInfoLog: bool
    m_showWarnLog: bool
    m_showErrorLog: bool
    m_showFatalLog: bool
    m_logBuffer: str
    m_logBufferMutex: Any

    def __init__(self) -> None: ...
    def __del__(self) -> None: ...
    def get_name(self) -> str: ...
    def set_name(self, name: str) -> None: ...
    def get_dir(self) -> str: ...
    def set_dir(self, dir: str) -> None: ...
    def set_level_on(self, log_level: int, on: bool) -> None: ...
    def is_level_on(self, log_level: int) -> bool: ...
    def init(self) -> bool: ...
    def log(self, log_level: int, tag: str, log_msg: str) -> None: ...
    def _append_line(self, time_str: str, tag_prefix: str, log_msg: str,
                     level_tag: str) -> None: ...
    def write(self) -> None: ...