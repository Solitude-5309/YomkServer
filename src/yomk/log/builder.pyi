from typing import Any, Callable, Optional

from yomk.msg.server import ResStatus, Response


class SinkLogBuilder:
    def __init__(self, loc: Any, sink: str) -> None: ...
    def tag(self, t: str) -> "SinkLogBuilder": ...
    def info(self, *args: Any) -> ResStatus: ...
    def warn(self, *args: Any) -> ResStatus: ...
    def error(self, *args: Any) -> ResStatus: ...
    def debug(self, *args: Any) -> ResStatus: ...
    def trace(self, *args: Any) -> ResStatus: ...
    def fatal(self, *args: Any) -> ResStatus: ...


class LogBuilder:
    def __init__(self, loc: Any) -> None: ...
    def tag(self, t: str) -> "LogBuilder": ...
    def to_sink(self, name: str) -> SinkLogBuilder: ...
    def info(self, *args: Any) -> ResStatus: ...
    def warn(self, *args: Any) -> ResStatus: ...
    def error(self, *args: Any) -> ResStatus: ...
    def debug(self, *args: Any) -> ResStatus: ...
    def trace(self, *args: Any) -> ResStatus: ...
    def fatal(self, *args: Any) -> ResStatus: ...


class ConsoleMgrBuilder:
    def __init__(self, name: str) -> None: ...
    def level(self, lv: int) -> "ConsoleMgrBuilder": ...
    def enable(self) -> ResStatus: ...
    def disable(self) -> ResStatus: ...
    def proxy(self, fn: Optional[Callable[[Any], bool]]) -> "ConsoleMgrBuilder": ...
    def apply(self) -> ResStatus: ...
    def list(self) -> Response: ...
    def get_info(self) -> Response: ...
    def status(self) -> Response: ...


class FileMgrBuilder:
    def __init__(self, name: str, dir_: str) -> None: ...
    def level(self, lv: int) -> "FileMgrBuilder": ...
    def enable(self) -> ResStatus: ...
    def disable(self) -> ResStatus: ...
    def proxy(self, fn: Optional[Callable[[Any], bool]]) -> "FileMgrBuilder": ...
    def apply(self) -> ResStatus: ...
    def list(self) -> Response: ...
    def get_info(self) -> Response: ...
    def status(self) -> Response: ...
    def create(self) -> ResStatus: ...
    def flush(self) -> ResStatus: ...
    def remove(self) -> ResStatus: ...


class LocBuilder:
    def __init__(self) -> None: ...
    def show_file(self, on: bool) -> "LocBuilder": ...
    def show_line(self, on: bool) -> "LocBuilder": ...
    def show_func(self, on: bool) -> "LocBuilder": ...
    def apply(self) -> ResStatus: ...


class LogMgrBuilder:
    def __init__(self) -> None: ...
    def dir(self, d: str) -> "LogMgrBuilder": ...
    def file(self, name: str = "") -> FileMgrBuilder: ...
    def console(self, name: str = "") -> ConsoleMgrBuilder: ...
    def location(self) -> LocBuilder: ...
    def all(self) -> Response: ...


def log() -> LogBuilder: ...
def log_mgr() -> LogMgrBuilder: ...