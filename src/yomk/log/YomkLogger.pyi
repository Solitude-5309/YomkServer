from typing import Any, Dict

from yomk.log.ConsoleLogger import ConsoleLogger
from yomk.log.FileLogger import FileLogger
from yomk.msg.log import LoggerState
from yomk.msg.server import Response
from yomk.server import YomkService


class YomkLogger(YomkService):
    # 日志服务（/YomkLogger 16 端点）：控制台/文件两套日志器表 + 两套全局主闸
    # + 两套代理（相互独立），输出取主闸 × 逐器两层 AND
    m_consoleLoggers: Dict[str, ConsoleLogger]
    m_consoleLoggersMutex: Any
    m_fileLoggers: Dict[str, FileLogger]
    m_fileLoggersMutex: Any
    m_showConsoleTraceLog: bool
    m_showConsoleDebugLog: bool
    m_showConsoleInfoLog: bool
    m_showConsoleWarningLog: bool
    m_showConsoleErrorLog: bool
    m_showConsoleFatalLog: bool
    m_showFileTraceLog: bool
    m_showFileDebugLog: bool
    m_showFileInfoLog: bool
    m_showFileWarningLog: bool
    m_showFileErrorLog: bool
    m_showFileFatalLog: bool
    m_consoleLogProxyMutex: Any
    m_consoleLogProxy: bool
    m_consoleLogProxyFunc: Any
    m_fileLogProxyMutex: Any
    m_fileLogProxy: bool
    m_fileLogProxyFunc: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    # 端点载荷形参一律 Any（无运行时守卫意义）：Cython 会把注解编译为边界
    # TypeError，先于运行时 unpack 守卫抛异常，误用载荷须返回契约 Response
    def console_log(self, pkg: Any) -> Response: ...
    def set_console_log_proxy(self, pkg: Any) -> Response: ...
    def set_file_log_proxy(self, pkg: Any) -> Response: ...
    def create_file_logger(self, pkg: Any) -> Response: ...
    def file_log(self, pkg: Any) -> Response: ...
    def write_file_log(self, pkg: Any) -> Response: ...
    def delete_logger(self, pkg: Any) -> Response: ...
    def off_console_log_by_level(self, pkg: Any) -> Response: ...
    def on_console_log_by_level(self, pkg: Any) -> Response: ...
    def set_named_console_level(self, logger_name: str, level: int,
                                on: bool) -> Response: ...
    def off_file_log_by_level(self, pkg: Any) -> Response: ...
    def on_file_log_by_level(self, pkg: Any) -> Response: ...
    def set_named_file_level(self, logger_name: str, level: int,
                             on: bool) -> Response: ...
    def loggers(self, pkg: Any) -> Response: ...
    def current_console_state(self) -> LoggerState: ...
    def named_console_state(self, console_logger: ConsoleLogger,
                            proxy_on: bool) -> LoggerState: ...
    def current_file_state(self) -> LoggerState: ...
    def named_file_state(self, file_logger: FileLogger,
                         proxy_on: bool) -> LoggerState: ...
    def logger_info(self, pkg: Any) -> Response: ...
    def list_all(self, pkg: Any) -> Response: ...
    def console_global_state(self, pkg: Any) -> Response: ...
    def file_global_state(self, pkg: Any) -> Response: ...