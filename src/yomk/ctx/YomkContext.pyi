from typing import Any, Dict, Tuple

from yomk.ctx.ContextGroup import ContextGroup
from yomk.msg.ctx import (
    Context,
    ContextChecker,
    ContextGroupKey,
    ContextMonitor,
)
from yomk.msg.server import Response
from yomk.server import YomkService


class YomkContext(YomkService):
    m_main: ContextGroup
    m_customGroup: Dict[str, ContextGroup]
    m_customGroupMutex: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    def deinit(self) -> None: ...
    def find_group(self, group_name: str) -> Tuple[Any, Any]: ...
    def turn_on_monitor(self, pkg: Any) -> Response: ...
    def turn_off_monitor(self, pkg: Any) -> Response: ...
    def set_monitor(self, contextMonitor: ContextMonitor) -> Response: ...
    def set_checker(self, contextChecker: ContextChecker) -> Response: ...
    def turn_on_checker(self, pkg: Any) -> Response: ...
    def turn_off_checker(self, pkg: Any) -> Response: ...
    def create(self, ctx: Context) -> Response: ...
    def destroy(self, groupKey: ContextGroupKey) -> Response: ...
    def get(self, ctx: Context) -> Response: ...
    def set(self, ctx: Context) -> Response: ...
    def groups(self, pkg: Any) -> Response: ...
    def keys(self, pkg: Any) -> Response: ...
    def key_info(self, pkg: ContextGroupKey) -> Response: ...
    def list_all(self, pkg: Any) -> Response: ...