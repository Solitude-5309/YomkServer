from typing import Any, Callable, Optional

from yomk.msgs.server import ResStatus, Response
from yomk.msgs.YomkMsg import YomkMsg


class GroupSwitch:
    def __init__(self, group: str, monitor: bool) -> None: ...
    def enable(self) -> ResStatus: ...
    def disable(self) -> ResStatus: ...


class ContextValueBuilder:
    def __init__(self, key: str, group: str, cls: type) -> None: ...
    def with_default(self, v: Optional[YomkMsg]) -> "ContextValueBuilder": ...
    def get(self) -> Optional[YomkMsg]: ...


class ContextBuilder:
    def __init__(self) -> None: ...
    def key(self, name: str) -> "ContextBuilder": ...
    def group(self, name: str = "main") -> "ContextBuilder": ...
    def value(self, ctx: Optional[YomkMsg]) -> "ContextBuilder": ...
    def create(self) -> ResStatus: ...
    def set(self) -> ResStatus: ...
    def destroy(self) -> ResStatus: ...
    def checker_fn(self, check_func: Optional[Callable[[Any], Any]]) -> "ContextBuilder": ...
    def monitor_fn(self, monitor_func: Optional[Callable[[Any], Any]]) -> "ContextBuilder": ...
    def async_(self, on: bool = True) -> "ContextBuilder": ...
    def apply(self) -> ResStatus: ...
    def checker(self) -> GroupSwitch: ...
    def monitor(self) -> GroupSwitch: ...
    def keys(self) -> Response: ...
    def info(self) -> Response: ...
    def groups(self) -> Response: ...
    def all(self) -> Response: ...
    def msg(self, cls: type) -> ContextValueBuilder: ...


def ctx() -> ContextBuilder: ...
