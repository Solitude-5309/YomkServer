from typing import Any, Callable, Optional

from yomk.msg.server import ResStatus, Response


class GroupSwitch:
    def __init__(self, group: str, monitor: bool) -> None: ...
    def enable(self) -> ResStatus: ...
    def disable(self) -> ResStatus: ...


class ContextValueBuilder:
    def __init__(self, key: str, group: str) -> None: ...
    def with_default(self, d: Any) -> "ContextValueBuilder": ...
    def get(self) -> Any: ...


class ContextBuilder:
    def __init__(self) -> None: ...
    def key(self, n: str) -> "ContextBuilder": ...
    def group(self, g: str = "main") -> "ContextBuilder": ...
    def value(self, v: Any) -> "ContextBuilder": ...
    def create(self) -> ResStatus: ...
    def set(self) -> ResStatus: ...
    def destroy(self) -> ResStatus: ...
    def checker_fn(self, fn: Optional[Callable[[Any], Any]]) -> "ContextBuilder": ...
    def monitor_fn(self, fn: Optional[Callable[[Any], Any]]) -> "ContextBuilder": ...
    def async_(self, on: bool = True) -> "ContextBuilder": ...
    def apply(self) -> ResStatus: ...
    def checker(self) -> GroupSwitch: ...
    def monitor(self) -> GroupSwitch: ...
    def keys(self) -> Response: ...
    def info(self) -> Response: ...
    def groups(self) -> Response: ...
    def all(self) -> Response: ...
    def msg(self, cls: Optional[type] = None) -> ContextValueBuilder: ...


def ctx() -> ContextBuilder: ...