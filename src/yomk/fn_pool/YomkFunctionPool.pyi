from typing import Any, Dict

from yomk.msg.server import Response
from yomk.server import YomkService


class YomkFunctionPool(YomkService):
    m_functions: Dict[str, Any]
    m_functionsMutex: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    # 端点载荷形参标注 Any（非 Function/CallFunction/str）：端点是裸链误用的
    # 第一道防线，运行时校验并返回 Failed "pkg is not X, got '<type>'"（对齐 C++
    # unpack 失败契约）；若标注具体类型，Cython 会按 pyi 注解在边界抛 TypeError，
    # 运行时守卫失效
    def registerFunction(self, function: Any) -> Response: ...
    def unRegisterFunction(self, func_name: Any) -> Response: ...
    def callFunction(self, call_func: Any) -> Response: ...
    def funcNames(self, pkg: Any) -> Response: ...
    def funcInfo(self, func_name: Any) -> Response: ...
    def listAll(self, pkg: Any) -> Response: ...