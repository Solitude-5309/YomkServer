from typing import Any, Dict

from yomk.msg.fn_pool import CallFunction, Function
from yomk.msg.server import Response
from yomk.server import YomkService


class YomkFunctionPool(YomkService):
    m_functions: Dict[str, Function]
    m_functionsMutex: Any

    def __init__(self, server: Any) -> None: ...
    def init(self) -> None: ...
    def registerFunction(self, function: Function) -> Response: ...
    def unRegisterFunction(self, func_name: str) -> Response: ...
    def callFunction(self, call_func: CallFunction) -> Response: ...
    def funcNames(self, pkg: Any) -> Response: ...
    def funcInfo(self, func_name: str) -> Response: ...
    def listAll(self, pkg: Any) -> Response: ...